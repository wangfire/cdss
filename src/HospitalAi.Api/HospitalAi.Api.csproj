<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\HospitalAi.Application\HospitalAi.Application.csproj" />
    <ProjectReference Include="..\HospitalAi.Contracts\HospitalAi.Contracts.csproj" />
    <ProjectReference Include="..\HospitalAi.Worker\HospitalAi.Worker.csproj" />
    <ProjectReference Include="..\HospitalAi.Infrastructure\HospitalAi.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- 使用无需商业许可证的 MassTransit 8.x，兼容当前 net10.0 目标框架。 -->
    <PackageReference Include="MassTransit.RabbitMQ" Version="8.5.7" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <!-- OpenTelemetry：HTTP/SQL/运行时 指标 + Prometheus 导出（设计基线 §18 / 验收标准 8）。
         注意：OpenTelemetry.Exporter.Prometheus.AspNetCore 1.10.0 仅有 beta 版，与核心 1.10.0 GA 配套。 -->
    <PackageReference Include="OpenTelemetry" Version="1.10.0" />
    <PackageReference Include="OpenTelemetry.Api" Version="1.10.0" />
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.10.0-beta.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.10.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.10.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.10.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.SqlClient" Version="1.10.0-beta.1" />
    <!-- JWT：RequestContextMiddleware 校验前端 Bearer 令牌（与 Infrastructure 认证服务共用 7.7.1）。 -->
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="7.7.1" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="7.7.1" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
