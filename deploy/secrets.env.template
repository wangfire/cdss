# =====================================================================
# CDSS 生产部署密钥模板（复制为 deploy/secrets.env 后填写真实值）
# 本文件与 secrets.env 均不得提交 git（.gitignore 已忽略 secrets.env）。
# 用法：cp deploy/secrets.env.template deploy/secrets.env && 填写后
#       docker compose -f deploy/docker-compose.prod.yml --env-file deploy/secrets.env up -d
# =====================================================================

# ---- JWT 签名密钥（≥32 字节，生成：openssl rand -base64 48）----
HOSPITAL_AI_JWT_KEY=REPLACE-WITH-openssl-rand-base64-48

# ---- SQL Server ----
HOSPITAL_AI_SQL_PASSWORD=REPLACE-WITH-STRONG-SA-PASSWORD

# ---- RabbitMQ ----
HOSPITAL_AI_RABBITMQ_USER=cdss_mq
HOSPITAL_AI_RABBITMQ_PASSWORD=REPLACE-WITH-STRONG-MQ-PASSWORD

# ---- Elasticsearch（生产启用 xpack.security）----
HOSPITAL_AI_ELASTIC_PASSWORD=REPLACE-WITH-STRONG-ES-PASSWORD

# ---- Redis ----
HOSPITAL_AI_REDIS_PASSWORD=REPLACE-WITH-STRONG-REDIS-PASSWORD

# ---- 限流/锁定（内网 NAT 环境按部署检查清单 §2.1 评审）----
HOSPITAL_AI_LOGIN_PERMIT_LIMIT=60
HOSPITAL_AI_LOGIN_WINDOW_SECONDS=60

# ---- CORS 允许的前端源（同源反代时可留空）----
HOSPITAL_AI_CORS_ORIGINS=

# ---- Nginx TLS ----
# 证书放 deploy/nginx/certs/（fullchain.pem + privkey.pem），不入 git
NGINX_SERVER_NAME=cdss.hospital.local
