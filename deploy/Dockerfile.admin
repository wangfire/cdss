# =====================================================================
# 前端管理端构建 + nginx 托管（WP-B 前端内网部署）
# 构建产物由 nginx 容器直接挂载（deploy/docker-compose.prod.yml 的
# ./nginx/frontend-dist 卷），本 Dockerfile 用于独立交付前端镜像的场景。
# =====================================================================

# 阶段 1：构建
FROM node:22-alpine AS build
WORKDIR /src
RUN corepack enable
COPY web-ui/package.json web-ui/pnpm-lock.yaml web-ui/pnpm-workspace.yaml ./
COPY web-ui/apps/admin/package.json apps/admin/
COPY web-ui/packages ./packages
COPY web-ui/internal ./internal
RUN pnpm install --frozen-lockfile
COPY web-ui/apps/admin ./apps/admin
RUN pnpm --filter @tabtab/admin build

# 阶段 2：nginx 托管
FROM nginx:1.27-alpine
COPY deploy/nginx/cdss.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/apps/admin/dist /usr/share/nginx/html
EXPOSE 80 443
