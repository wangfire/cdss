{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "DataProtection": {
    "KeysPath": "/var/hospitalai/dpkeys"
  },
  "Security": {
    "AllowHeaderIdentity": false,
    "Lockout": {
      "MaxFailedAccessAttempts": 5,
      "LockoutDurationMinutes": 15
    },
    "RateLimit": {
      "LoginPermitLimit": 60,
      "LoginWindowSeconds": 60
    },
    "CorsOrigins": [],
    "ForwardedHeaders": {
      "KnownProxies": []
    }
  }
}
