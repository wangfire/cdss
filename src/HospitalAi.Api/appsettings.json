{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "HospitalAi": ""
  },
  "RabbitMq": {
    "Enabled": false,
    "Host": "localhost",
    "Port": 5673,
    "VirtualHost": "/",
    "Username": "guest",
    "Password": "guest",
    "QueueName": "coding.task.created"
  },
  "JwtAuth": {
    "Key": "REPLACE-WITH-A-LONG-RANDOM-SECRET-OF-AT-LEAST-32-BYTES-0123456789",
    "Issuer": "hospitalai",
    "Audience": "hospitalai-admin",
    "ClockSkewSeconds": 30,
    "TokenLifetimeMinutes": 120
  },
  "HealthChecks": {
    "Redis": {
      "Enabled": true,
      "Host": "localhost",
      "Port": 6379
    },
    "RabbitMq": {
      "Enabled": true,
      "Host": "localhost",
      "Port": 5673
    }
  },
  "AllowedHosts": "*",
  "Coding": {
    "Pipeline": {
      "DefaultPipelineVersion": "phase1-v2.2-lite"
    },
    "V22Lite": {
      "KnowledgeVersion": "v1",
      "CodingVersion": "v1",
      "DocumentVersion": "v1",
      "RuleVersion": "v1",
      "MaxCandidatesPerInput": 3,
      "RuleEngineEnabled": true,
      "ExplanationModelCode": "model.small",
      "PromptVersion": "v22-explanation-v1"
    },
    "Scoring": {
      "ExactWeight": 0.15,
      "SemanticWeight": 0.15,
      "RetrievalWeight": 0.1,
      "RerankWeight": 0.1,
      "RuleWeight": 0.15,
      "EvidenceWeight": 0.2,
      "LlmWeight": 0.15,
      "HighConfidenceFinalScore": 0.85,
      "HighConfidenceEvidenceScore": 0.75,
      "MinimumMargin": 0.1
    }
  },
  "ModelGateway": {
    "ModelMode": "unavailable",
    "BaseUrl": null,
    "ApiKey": null,
    "TimeoutSeconds": 60,
    "Models": {}
  },
  "Elasticsearch": {
    "Enabled": true,
    "Url": "http://localhost:9201",
    "Username": null,
    "Password": null,
    "TimeoutSeconds": 5
  }
}
